# Shared agent tooling for every machine that runs or drives coding agents
# (see docs/plans/2026-11-17-agentic-workspace-design.md). Hosts import this
# together with exactly one of `agent-host` / `agent-client` (+ `agent-t3code`,
# `agent-opencode`).
#
# Provides: the `preferences.agents.*` options, Claude Code with shared MCP
# servers and pinned skills, the `agent-notify` hook (desktop notification +
# optional ntfy), the `agent-status` hooks (per-session state for a bar
# widget), herdr with its config, and review tools. OpenCode lives in
# `agent-opencode`, T3 Code in `agent-t3code`.
#
# ~/.claude/settings.json is NOT generated by home-manager (that would replace
# the user's file with a read-only store symlink and break Claude's own writes
# and plugin toggles). Instead an activation step merges the few managed keys
# (permission denies, agent-notify / agent-status hooks) into the existing file.
{inputs, ...}: {
  flake.nixosModules.agent-common = {
    config,
    lib,
    pkgs,
    ...
  }: let
    cfg = config.preferences.agents;
    user = config.preferences.user.name;
    system = pkgs.stdenv.hostPlatform.system;
    llm = inputs.llm-agents.packages.${system};

    # Same package the VSCodium extension is pinned against (features/vscode.nix).
    claudePkg = inputs.claude-code.packages.${system}.claude-code;

    # Selected skills from anthropics/skills (pinned flake input). The
    # document skills (docx/pdf/pptx/xlsx) are source-available, not open
    # source, and come with claude.ai anyway — leave them out.
    anthropicSkills = [
      "skill-creator"
      "mcp-builder"
      "webapp-testing"
      "frontend-design"
    ];

    agentNotify = pkgs.writeShellApplication {
      name = "agent-notify";
      runtimeInputs = [pkgs.jq pkgs.libnotify pkgs.curl pkgs.coreutils];
      text = ''
        # Usage: Claude Code hook (JSON on stdin), or `agent-notify TITLE [BODY]`.
        host=$(uname -n)
        urgency=normal
        prio=default
        if [ "$#" -ge 1 ]; then
          title=$1
          body=''${2:-}
        else
          input=""
          if [ ! -t 0 ]; then input=$(cat || true); fi
          field() { jq -r --arg k "$1" '.[$k] // empty' <<<"$input" 2>/dev/null || true; }
          event=$(field hook_event_name)
          msg=$(field message)
          cwd=$(field cwd)
          project=$(basename "''${cwd:-$PWD}")
          case "$event" in
            Notification)
              title="Claude needs input - $project"
              body=''${msg:-Waiting for input}
              prio=high
              ;;
            Stop)
              title="Claude done - $project"
              body="Finished on $host"
              urgency=low
              ;;
            *)
              title="Agent - $project"
              body=''${msg:-''${event:-event}}
              ;;
          esac
        fi

        notify-send -a "Claude Code" -u "$urgency" "$title" "$body" >/dev/null 2>&1 || true

        topic_file=${lib.escapeShellArg (toString cfg.ntfy.topicFile)}
        if [ -n "$topic_file" ] && [ -r "$topic_file" ]; then
          topic=$(tr -d '[:space:]' <"$topic_file")
          case "$topic" in
            http://* | https://*) url=$topic ;;
            *) url="https://ntfy.sh/$topic" ;;
          esac
          curl -fsS --max-time 10 -H "Title: $title" -H "Priority: $prio" \
            -H "Tags: robot" -d "$body" "$url" >/dev/null 2>&1 || true
        fi
        exit 0
      '';
    };

    # Per-session state for a bar widget (the waybar side reads it):
    # $XDG_RUNTIME_DIR/agent-status/<session_id> holds the state word on line 1
    # (working | input | done) and the project basename on line 2; SessionEnd
    # removes it. Local files + a signal only: no network, never fails the hook.
    agentStatus = pkgs.writeShellApplication {
      name = "agent-status";
      runtimeInputs = [pkgs.jq pkgs.coreutils pkgs.procps];
      text = ''
        # Usage: Claude Code hook (JSON on stdin): agent-status working|input|done|end
        state=''${1:-}
        input=""
        if [ ! -t 0 ]; then input=$(cat || true); fi
        sid=$(jq -r '.session_id // empty' <<<"$input" 2>/dev/null || true)
        cwd=$(jq -r '.cwd // empty' <<<"$input" 2>/dev/null || true)
        sid=$(printf '%s' "$sid" | tr -cd 'A-Za-z0-9_.-')
        if [ -z "$state" ] || [ -z "$sid" ]; then exit 0; fi
        dir="''${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/agent-status"
        f="$dir/$sid"
        if [ "$state" = end ]; then
          [ -e "$f" ] || exit 0
          rm -f "$f"
        else
          new=$(printf '%s\n%s' "$state" "$(basename "''${cwd:-$PWD}")")
          # PreToolUse fires often: skip the write + signal when nothing changed.
          if [ -r "$f" ] && [ "$(cat "$f" 2>/dev/null || true)" = "$new" ]; then exit 0; fi
          mkdir -p "$dir" || exit 0
          printf '%s\n' "$new" >"$f.tmp" && mv -f "$f.tmp" "$f" || exit 0
        fi
        pkill -RTMIN+10 -x waybar >/dev/null 2>&1 || true
        exit 0
      '';
    };

    # Keys merged into ~/.claude/settings.json (everything else is left alone).
    managedClaudeSettings = {
      permissions.deny = [
        "Bash(sudo:*)"
        "Bash(doas:*)"
        "Bash(rm -r:*)"
        "Bash(rm -rf:*)"
        "Bash(nix copy:*)"
      ];
      hooks = let
        group = commands: [
          {
            matcher = "";
            hooks =
              map (command: {
                type = "command";
                inherit command;
              })
              commands;
          }
        ];
        status = state: "${lib.getExe agentStatus} ${state}";
      in {
        UserPromptSubmit = group [(status "working")];
        PreToolUse = group [(status "working")];
        Notification = group [(status "input") (lib.getExe agentNotify)];
        Stop = group [(status "done") (lib.getExe agentNotify)];
        SessionEnd = group [(status "end")];
      };
    };

    claudeSettingsMerge = pkgs.writeShellApplication {
      name = "claude-settings-merge";
      runtimeInputs = [pkgs.jq pkgs.coreutils];
      text = ''
        f="$HOME/.claude/settings.json"
        mkdir -p "$(dirname "$f")"
        if [ -e "$f" ]; then
          if ! cur=$(jq -e . "$f" 2>/dev/null); then
            echo "claude-settings-merge: $f is not valid JSON, leaving it untouched" >&2
            exit 0
          fi
        else
          cur='{}'
        fi
        # deny lists are unioned; for each managed hook event, previous
        # agent-notify / agent-status entries are replaced and the user's own
        # hooks kept.
        new=$(jq -n --argjson cur "$cur" --slurpfile m ${pkgs.writeText "claude-managed.json" (builtins.toJSON managedClaudeSettings)} '
          $m[0] as $m
          | $cur
          | .permissions = ((.permissions // {})
              | .deny = (((.deny // []) + $m.permissions.deny) | unique))
          | .hooks = (reduce ($m.hooks | keys[]) as $ev ((.hooks // {});
              .[$ev] = (((.[$ev] // []) | map(select(tojson | (contains("agent-notify") or contains("agent-status")) | not)))
                        + $m.hooks[$ev])))
        ')
        if [ "$new" = "$cur" ]; then exit 0; fi
        tmp=$(mktemp "$f.XXXXXX")
        printf '%s\n' "$new" >"$tmp"
        chmod 600 "$tmp"
        mv -f "$tmp" "$f"
      '';
    };

    herdrConfig = (pkgs.formats.toml {}).generate "herdr-config.toml" {
      onboarding = false;
      # Built-in Catppuccin themes match preferences.theme (catppuccin source):
      # follow the terminal's light/dark like the rest of the desktop.
      theme = {
        name = "catppuccin";
        auto_switch = true;
        dark_name = "catppuccin";
        light_name = "catppuccin-latte";
      };
      # Updates come from the flake (llm-agents input), not `herdr update`.
      update.version_check = false;
    };
  in {
    options.preferences.agents = {
      role = lib.mkOption {
        type = lib.types.nullOr (lib.types.enum ["host" "client"]);
        default = null;
        description = "Set by agent-host / agent-client.";
      };

      target = lib.mkOption {
        type = lib.types.nullOr lib.types.str;
        default = null;
        example = "butternut";
        description = ''
          Default compute target (Tailscale/MagicDNS name) a client attaches to:
          T3 Code UI, `herdr --remote`.
        '';
      };

      ntfy = {
        enable = lib.mkEnableOption ''
          ntfy push notifications from agent hooks. The topic (name or full
          URL) is read from sops: secrets/shared/agents.yaml, key `ntfy-topic`
        '';
        topicFile = lib.mkOption {
          type = lib.types.nullOr lib.types.str;
          default =
            if cfg.ntfy.enable
            then config.sops.secrets."agents-ntfy-topic".path
            else null;
          defaultText = lib.literalExpression ''sops secret path when ntfy.enable, else null'';
          description = "File holding the ntfy topic (or URL). null = desktop notifications only.";
        };
      };

      llamaSwapUrl = lib.mkOption {
        type = lib.types.str;
        default = "http://peacelily:9292/v1";
        description = "OpenAI-compatible llama-swap endpoint for OpenCode.";
      };

      tailnetDomain = lib.mkOption {
        type = lib.types.nullOr lib.types.str;
        default = null;
        example = "tail1234.ts.net";
        description = ''
          MagicDNS suffix of the tailnet (`tailscale status --json | jq -r
          .MagicDNSSuffix`). Clients build the HTTPS URLs of the services a
          host exposes with `tailscale serve` from it:
          https://<target>.<tailnetDomain>[:port]/.
        '';
      };

      projects = lib.mkOption {
        type = lib.types.listOf lib.types.str;
        default = [];
        example = lib.literalExpression ''["/home/alice/src/project"]'';
        description = ''
          Absolute checkout paths registered with the agent UIs on this host
          (T3 Code: `t3 project add`). Paths that do not exist are skipped.
        '';
      };
    };

    config = {
      sops.secrets."agents-ntfy-topic" = lib.mkIf cfg.ntfy.enable {
        sopsFile = ../../.. + "/secrets/shared/agents.yaml";
        key = "ntfy-topic";
        owner = user;
      };

      home-manager.users.${user} = {
        programs.mcp = {
          enable = true;
          servers = {
            # Versions pinned by flake.lock (nixpkgs), not a floating branch.
            nixos.command = lib.getExe pkgs.mcp-nixos;
            git.command = lib.getExe pkgs.mcp-server-git;
          };
        };

        programs.claude-code = {
          enable = true;
          package = claudePkg;
          # MCP servers + plugins reach the CLI via a `--plugin-dir` wrapper,
          # so ~/.claude.json is untouched. (The VSCodium extension runs its
          # own bundled binary and does not see these.)
          enableMcpIntegration = true;
          plugins = ["${inputs.superpowers}"];
          skills = lib.genAttrs anthropicSkills (n: "${inputs.anthropic-skills}/skills/${n}");
        };

        # (NixOS lib has no lib.hm: spell out the DAG entry.)
        home.activation.claudeSettingsMerge = {
          after = ["writeBoundary"];
          before = [];
          data = "run ${lib.getExe claudeSettingsMerge}";
        };

        xdg.configFile."herdr/config.toml".source = herdrConfig;

        home.packages = [
          llm.herdr
          llm.hunk
          llm.tuicr
          pkgs.difftastic
          pkgs.lazygit
          # Claude Code voice dictation records via SoX (`rec`) or arecord;
          # without one it fails silently.
          pkgs.sox
          # GitLab CLI: both work projects live on GitLab (T3 Code uses it to
          # browse merge requests; agents use it for MRs/issues/CI).
          pkgs.glab
          agentNotify
          agentStatus
        ];
      };
    };
  };
}
