# Ignore build outputs from performing a nix-build or `nix build` command
result
result-*

# Ignore automatically generated direnv output
.direnv

.devenv
.pre-commit-config.yaml
# Local reference clones (not part of the config; submodules are tracked separately)
.repos/survey/
.repos/CQL/
__pycache__/

# Local list of strings for scripts/repo/scrub-unpushed-history.sh (never commit)
scripts/repo/*.local

# Claude Code EnterWorktree worktrees
.claude/worktrees/
